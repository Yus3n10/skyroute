# CognoDB Cloud connection. Create a free c0 instance at https://console.cognodb.com/signup
# The password is shown exactly once at creation time - copy it then.
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=<your-generated-password>

# Optional. Bolt connections are pooled; the free c0 tier allows up to 200.
COGNODB_MAX_POOL_SIZE=20
